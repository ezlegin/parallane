generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CourseStatus {
  draft
  published
}

enum CourseCategory {
  webDesign
  frontEnd
  backEnd
}

enum LessonType {
  video
  doc
}

enum MembershipPeriod {
  monthly
  annual
}

enum MembershipStatus {
  active
  expired
}

enum PaymentStatus {
  pending
  success
  failed
}

enum DiscountType {
  fixed
  percentage
}

enum CouponStatus {
  active
  disabled
}

enum TutorMessageRole {
  user
  tutor
}

enum TutorConversationStatus {
  replied
  waiting
  closed
}

enum CourseProgressStatus {
  notStarted
  inProgress
  completed
}

model Admin {
  id       String @id @default(uuid())
  fullName String
  email    String @unique
  password String
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String

  fullName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  payments    Payment[]
  enrollments Enrollment[]

  courseProgresses CourseProgress[]
  lessonProgresses LessonProgress[]

  conversations TutorConversation[]
  certificates  Certificate[]

  couponUsages CouponUsage[]

  @@index([createdAt])
}

model Course {
  id String @id @default(uuid())

  title String
  slug  String @unique

  summary     String
  description String

  category CourseCategory
  status   CourseStatus   @default(draft)

  audience String[]

  teaserUrl String?
  duration  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasons     Season[]
  enrollments Enrollment[]

  courseProgresses   CourseProgress[]
  certificates       Certificate[]
  tutorConversations TutorConversation[]

  @@index([category])
  @@index([status])
  @@index([createdAt])
}

model Season {
  id String @id @default(uuid())

  title String

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id String @id @default(uuid())

  title String

  type LessonType
  url  String

  isFree   Boolean @default(false)
  duration Int     @default(0)

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  progress           LessonProgress[]
  tutorConversations TutorConversation[]

  @@index([seasonId])
}

model Membership {
  id        String @id @default(uuid())
  reference String @unique @default("par-0012")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status MembershipStatus @default(active)
  period MembershipPeriod

  price Float

  startsAt  DateTime @default(now())
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment     Payment?
  enrollments Enrollment[]

  @@index([status])
  @@index([expiresAt])
}

model Payment {
  id        String @id @default(uuid())
  reference String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  membershipId String?     @unique
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  status PaymentStatus @default(pending)

  totalAmount    Float
  discountAmount Float
  paidAmount     Float

  discountType DiscountType?
  discountCode String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  couponUsage CouponUsage?

  @@index([userId])
  @@index([membershipId])
  @@index([status])
  @@index([paidAt])
  @@index([createdAt])
}

model Coupon {
  id String @id @default(uuid())

  code String @unique

  summary        String
  discountType   DiscountType
  discountAmount Float

  status CouponStatus @default(active)

  expiresAt DateTime?

  usageLimit Int?
  usageCount Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages CouponUsage[]

  @@index([status])
  @@index([expiresAt])
}

model CouponUsage {
  id String @id @default(uuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  discountAmount Float

  createdAt DateTime @default(now())

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
}

model Enrollment {
  id        String @id @default(uuid())
  reference String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  enrolledAt DateTime @default(now())

  completedAt DateTime?

  progress CourseProgress?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model CourseProgress {
  id String @id @default(uuid())

  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  completedLessons Int @default(0)
  totalLessons     Int

  percentage Float                @default(0)
  stats      CourseProgressStatus @default(notStarted)

  lastLessonId String?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  watchedSeconds Int @default(0)

  completed     Boolean   @default(false)
  completedAt   DateTime?
  lastWatchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model TutorConversation {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String? //todo: remove this optinal sign.
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade) //todo: remove this optinal sign.

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  status TutorConversationStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TutorMessage[]

  @@index([userId])
  @@index([courseId])
  @@index([lessonId])
}

model TutorMessage {
  id String @id @default(uuid())

  conversationId String
  conversation   TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role TutorMessageRole

  content String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model Certificate {
  id String @id @default(uuid())

  certificateNumber String @unique
  url               String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  issuedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}
